# ─── Credencial ──────────────────────────────────────────────────────────────
# API key do build.nvidia.com (formato nvapi-...). Créditos grátis, não expiram.
# NUNCA commitar o .env — o .gitignore já bloqueia.
NVIDIA_API_KEY=

# Alternativa neutra: se trocar de provedor, preencher esta em vez da de cima.
# LLM_API_KEY=

# ─── LLM dos agentes ─────────────────────────────────────────────────────────
# Endpoint OpenAI-compatible. Trocar de provedor = trocar estas duas linhas.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.1

# ─── Embeddings (NeMo Retriever) ─────────────────────────────────────────────
# llama-nemotron-embed-1b-v2: devolve 2048 dims, mas aceita Matryoshka via `dimensions`.
# Pedimos 1024 porque pgvector NÃO indexa HNSW acima de 2000 dims (verificado em 22/08).
# Medido em 22/08: PT relevante 0.3766 vs irrelevante 0.0332; crosslingual PT->EN 0.4282.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIM=1024

# ─── Reranking ───────────────────────────────────────────────────────────────
# Cross-encoder. Substitui o Cohere Rerank (pago) que o TAPI sugere.
# ATENÇÃO: a URL de reranking embute o nome do modelo no path — trocar os dois juntos.
# Os endpoints citados no TAPI (llama-3.2-nv-rerankqa) morreram em 18/05/2026 (HTTP 410).
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# ─── Banco ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/case_nvidia

# ─── Controle de custo ───────────────────────────────────────────────────────
# Teto de startups por consulta. O fan-out roda o pipeline 1x por startup,
# então N startups = N x 5 chamadas de LLM.
MAX_STARTUPS=5
