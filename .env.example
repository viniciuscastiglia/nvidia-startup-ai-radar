# ─── Credencial ──────────────────────────────────────────────────────────────
# API key do build.nvidia.com (formato nvapi-...). Créditos grátis, não expiram.
# NUNCA commitar o .env — o .gitignore já bloqueia.
NVIDIA_API_KEY=

# Alternativa neutra: se trocar de provedor, preencher esta em vez da de cima.
# LLM_API_KEY=

# ─── LLM dos agentes ─────────────────────────────────────────────────────────
# Endpoint OpenAI-compatible. Trocar de provedor = trocar estas duas linhas.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.1

# ─── Embeddings (NeMo Retriever) ─────────────────────────────────────────────
# llama-3.2-nv-embedqa-1b-v2: multilíngue (26 idiomas, inclui português) e crosslingual.
# Crosslingual importa aqui: a base NVIDIA é em inglês, os perfis das startups em português.
# EMBEDDING_DIM usa Matryoshka — 384/512/768/1024/2048.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
EMBEDDING_DIM=1024

# ─── Reranking ───────────────────────────────────────────────────────────────
# Cross-encoder. Substitui o Cohere Rerank (pago) que o TAPI sugere.
RERANK_URL=https://integrate.api.nvidia.com/v1/ranking
RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# ─── Banco ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/case_nvidia

# ─── Controle de custo ───────────────────────────────────────────────────────
# Teto de startups por consulta. O fan-out roda o pipeline 1x por startup,
# então N startups = N x 5 chamadas de LLM.
MAX_STARTUPS=5
